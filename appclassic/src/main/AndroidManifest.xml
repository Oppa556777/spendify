<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.myexpense.tracker"
    android:versionCode="1"
    android:versionName="1.0.0">

    <!-- Fully offline by design: NO INTERNET permission, no network code. -->

    <uses-permission
        android:name="android.permission.USE_BIOMETRIC"
        tools:targetApi="28" xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:targetApi="26" xmlns:tools="http://schemas.android.com/tools" />

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoneyMate">

        <activity
            android:name=".ui.LockActivity"
            android:exported="true"
            android:theme="@style/Theme.MoneyMate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AddEditTransactionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AccountsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CategoriesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SearchActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BackupRestoreActivity"
            android:exported="false" />
    </application>

</manifest>
