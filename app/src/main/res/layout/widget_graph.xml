<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_graph_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_graph_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Last 7 days"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_graph_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today: ₹0"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_bars"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom"
            android:padding="2dp">
            <View
                android:id="@+id/bar0"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/widget_bar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom"
            android:padding="2dp">
            <View
                android:id="@+id/bar1"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/widget_bar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom"
            android:padding="2dp">
            <View
                android:id="@+id/bar2"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/widget_bar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom"
            android:padding="2dp">
            <View
                android:id="@+id/bar3"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/widget_bar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom"
            android:padding="2dp">
            <View
                android:id="@+id/bar4"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/widget_bar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom"
            android:padding="2dp">
            <View
                android:id="@+id/bar5"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/widget_bar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom"
            android:padding="2dp">
            <View
                android:id="@+id/bar6"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/widget_bar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
