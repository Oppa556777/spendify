<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        NOTE: This app is fully offline by design.
        There is deliberately NO INTERNET permission and no network usage anywhere.
        All data lives in the on-device Room database.
    -->

    <uses-permission
        android:name="android.permission.USE_BIOMETRIC"
        tools:targetApi="28" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:targetApi="26" />

    <application
        android:name=".MoneyMateApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoneyMate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MoneyMate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
